{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ziozzang/pumgye/docs/schema/policy-v2.schema.json",
  "title": "Pumgye policy document version 2 (ADR 0021)",
  "description": "Descriptive schema. The serde model in pumgye_core::v2 (deny_unknown_fields) and the compiler bounds are normative.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "catalog",
    "services"
  ],
  "properties": {
    "version": {
      "const": 2
    },
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "levels"
      ],
      "properties": {
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "levels": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
          },
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "description": "ascending"
        },
        "compartments": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
          },
          "maxItems": 64,
          "uniqueItems": true
        },
        "resources": {
          "type": "object",
          "maxProperties": 65536,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "service",
              "level",
              "actions"
            ],
            "properties": {
              "service": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
              },
              "level": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
              },
              "compartments": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
                }
              },
              "minimum_aal": {
                "type": "integer",
                "minimum": 0,
                "maximum": 3
              },
              "actions": {
                "type": "object",
                "minProperties": 1,
                "maxProperties": 64,
                "additionalProperties": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
                }
              }
            }
          }
        }
      }
    },
    "zones": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": {
          "enum": [
            "sumunjang",
            "local"
          ]
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "zones": {
          "type": "object",
          "maxProperties": 64,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "prefixes"
            ],
            "properties": {
              "prefixes": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "description": "canonical CIDR without host bits"
                }
              }
            }
          }
        }
      }
    },
    "templates": {
      "type": "object",
      "maxProperties": 1024,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "permissions",
          "clearance_ceiling"
        ],
        "properties": {
          "permissions": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
            },
            "maxItems": 256,
            "uniqueItems": true
          },
          "inherits": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
            },
            "maxItems": 8,
            "uniqueItems": true
          },
          "clearance_ceiling": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "level"
                ],
                "properties": {
                  "level": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
                  },
                  "compartments": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
                    }
                  }
                }
              }
            ]
          },
          "minimum_aal": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3
          }
        }
      }
    },
    "services": {
      "type": "object",
      "maxProperties": 4096,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "permissions"
        ],
        "properties": {
          "permissions": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
            },
            "minItems": 1,
            "maxItems": 256,
            "uniqueItems": true
          },
          "permission_map": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
            }
          },
          "network_ceiling": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "zone",
                "max"
              ],
              "properties": {
                "zone": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
                },
                "max": {
                  "oneOf": [
                    {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
                    },
                    {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
                      },
                      "maxItems": 8
                    }
                  ]
                }
              }
            }
          },
          "require_guard": {
            "type": "boolean",
            "default": true
          },
          "authorization_context": {
            "const": "network_and_guard"
          }
        }
      }
    },
    "bindings": {
      "type": "array",
      "maxItems": 1048576,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "effect",
          "subjects",
          "scope"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^bnd_[A-Za-z0-9_-]{1,64}$"
          },
          "effect": {
            "enum": [
              "allow",
              "deny"
            ]
          },
          "subjects": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "ref"
                  ],
                  "properties": {
                    "kind": {
                      "enum": [
                        "human",
                        "service",
                        "workload"
                      ]
                    },
                    "ref": {
                      "type": "string",
                      "pattern": "^(human1:[0-9a-f]{64}|s_[0-9a-f]{48}|wk2:[0-9a-f]{64})$"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "group"
                  ],
                  "properties": {
                    "group": {
                      "type": "string",
                      "pattern": "^grp1:[0-9abcdefghjkmnpqrstvwxyz]{26}$"
                    }
                  }
                }
              ]
            }
          },
          "role": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
          },
          "permissions": {
            "oneOf": [
              {
                "const": "all"
              },
              {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
                },
                "minItems": 1
              }
            ]
          },
          "scope": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "services"
            ],
            "properties": {
              "services": {
                "oneOf": [
                  {
                    "const": "all"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
                    },
                    "minItems": 1
                  }
                ]
              }
            }
          },
          "conditions": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "zones": {
                "oneOf": [
                  {
                    "const": "any"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
                    },
                    "minItems": 1
                  }
                ]
              },
              "minimum_aal": {
                "type": "integer",
                "minimum": 0,
                "maximum": 3
              },
              "not_before": {
                "type": "string",
                "format": "date-time",
                "description": "RFC 3339; canonical output YYYY-MM-DDTHH:MM:SSZ"
              },
              "expires_at": {
                "type": "string",
                "format": "date-time",
                "description": "RFC 3339; canonical output YYYY-MM-DDTHH:MM:SSZ"
              }
            }
          },
          "metadata": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "granted_by": {
                "type": "string",
                "description": "server-stamped; ignored on input"
              },
              "approval_ref": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "source": {
                "type": "string",
                "maxLength": 128
              },
              "created_at": {
                "type": "string",
                "format": "date-time",
                "description": "RFC 3339; canonical output YYYY-MM-DDTHH:MM:SSZ"
              },
              "revision": {
                "type": "integer",
                "description": "server-stamped"
              }
            }
          }
        },
        "oneOf": [
          {
            "properties": {
              "effect": {
                "const": "allow"
              }
            },
            "required": [
              "role"
            ],
            "not": {
              "required": [
                "permissions"
              ]
            }
          },
          {
            "properties": {
              "effect": {
                "const": "deny"
              }
            },
            "required": [
              "permissions"
            ],
            "not": {
              "required": [
                "role"
              ]
            }
          }
        ]
      }
    }
  }
}
